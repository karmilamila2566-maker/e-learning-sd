# GEMINI_API_KEY: Required for Gemini AI API calls (Kurikulum Merdeka SD Task Generator).
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, set this in Project Settings > Environment Variables.
GEMINI_API_KEY="your-gemini-api-key"

# Supabase Credentials:
# Dapatkan dari Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Opsional: Service Role Key (hanya untuk script admin/migration server-side jika dibutuhkan)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
